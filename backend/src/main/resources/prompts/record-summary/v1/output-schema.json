{
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "headline", "executiveSummary", "progress", "risks", "nextActions", "evidence", "limitations", "period"],
  "properties": {
    "schemaVersion": {"type": "integer"},
    "headline": {"type": "string", "minLength": 1, "maxLength": 200},
    "executiveSummary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "progress": {
      "type": "array", "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "statement", "evidenceRefs"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 60},
          "statement": {"type": "string", "minLength": 1, "maxLength": 1000},
          "evidenceRefs": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 60}}
        }
      }
    },
    "risks": {
      "type": "array", "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "statement", "severity", "evidenceRefs"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 60},
          "statement": {"type": "string", "minLength": 1, "maxLength": 1000},
          "severity": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
          "evidenceRefs": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 60}}
        }
      }
    },
    "nextActions": {
      "type": "array", "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "statement", "basis", "evidenceRefs"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 60},
          "statement": {"type": "string", "minLength": 1, "maxLength": 1000},
          "basis": {"type": "string", "enum": ["REVIEW_FEEDBACK", "MODEL_SUGGESTION"]},
          "evidenceRefs": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 60}}
        }
      }
    },
    "evidence": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ref", "type", "id", "label"],
        "properties": {
          "ref": {"type": "string", "minLength": 1, "maxLength": 60},
          "type": {"type": "string", "enum": ["PROJECT", "RECORD", "REVISION", "REVIEW", "AUDIT_EVENT", "REVISION_DIFF"]},
          "id": {"type": "string", "minLength": 1, "maxLength": 160},
          "recordId": {"type": "string", "maxLength": 36},
          "revisionId": {"type": "string", "maxLength": 36},
          "reviewId": {"type": "string", "maxLength": 36},
          "fromRevisionId": {"type": "string", "maxLength": 36},
          "toRevisionId": {"type": "string", "maxLength": 36},
          "label": {"type": "string", "minLength": 1, "maxLength": 300}
        }
      }
    },
    "limitations": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "period": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "minLength": 1, "maxLength": 40},
        "end": {"type": "string", "minLength": 1, "maxLength": 40}
      }
    }
  }
}
